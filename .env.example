# Which backend answers. GROK is the default; GOOGLE selects Gemini Live.
MODEL=GROK

# Locale for the voice. POSIX or BCP-47 spelling both work (pt_BR, pt-BR).
# Omitted entirely when unset — both APIs reject a null here.
LANGUAGE=pt-BR

# xAI — required when MODEL=GROK
GROK_API_KEY=your-key-here
GROK_LIVE_MODEL=grok-voice-latest
GROK_LIVE_VOICE=eve

# Gemini Developer API (AI Studio) — NOT Vertex. Required when MODEL=GOOGLE.
GOOGLE_API_KEY=your-key-here
GOOGLE_LIVE_MODEL=gemini-3.1-flash-live-preview
GOOGLE_LIVE_VOICE=Aoede

# the HTTP port
PORT=8000

# --- latency knobs -----------------------------------------------------------
# Both are optional; the defaults below are what the app uses when they are unset,
# and priv/spike/latency_bench.exs measures what moving them actually buys.

# How long a provider's VAD waits in silence before deciding your turn is over.
# A hard floor under every answer: nothing comes back until it elapses. 0..10000.
SILENCE_DURATION_MS=400

# Mic batch size in 16 kHz samples; 1600 = 100 ms. Reaches the browser's AudioWorklet
# through /config.json. Smaller shortens the tail of an utterance but multiplies the
# frame rate — 160 was measured at roughly 15x WORSE. 160..16000.
FRAME_SAMPLES=1600
