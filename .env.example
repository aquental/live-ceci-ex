# Which backend answers. GROK is the default; GOOGLE selects Gemini Live.
MODEL=GROK

# Locale for the voice. POSIX or BCP-47 spelling both work (pt_BR, pt-BR).
# Omitted entirely when unset — both APIs reject a null here.
LANGUAGE=pt-BR

# xAI — required when MODEL=GROK
GROK_API_KEY=your-key-here
GROK_LIVE_MODEL=grok-voice-latest
GROK_LIVE_VOICE=eve

# Gemini Developer API (AI Studio) — NOT Vertex. Required when MODEL=GOOGLE.
GOOGLE_API_KEY=your-key-here
GOOGLE_LIVE_MODEL=gemini-3.1-flash-live-preview
GOOGLE_LIVE_VOICE=Aoede

# the HTTP port
PORT=8000

# --- latency knobs -----------------------------------------------------------
# Both are optional; the defaults below are what the app uses when they are unset,
# and priv/spike/latency_bench.exs measures what moving them actually buys.

# How long a provider's VAD waits in silence before deciding your turn is over.
# A hard floor under every answer: nothing comes back until it elapses. 0..10000.
SILENCE_DURATION_MS=400

# Mic batch size in 16 kHz samples; 1600 = 100 ms. Reaches the browser's AudioWorklet
# through /config.json. Smaller shortens the tail of an utterance but multiplies the
# frame rate — 160 was measured at roughly 15x WORSE. 160..16000.
FRAME_SAMPLES=1600

# Who decides your turn ended. Measured on xAI, three interleaved reps against a fixed
# utterance: 1818 ms median from end of speech to first byte of voice with the server's
# own VAD, 985 ms with the browser's gate closing the turn. `manual` is the default and
# the fast one; `server` is the way back if false turns start cutting people off
# mid-sentence, which is what the 833 ms costs. Gemini ignores this — its own VAD
# already answers in 1220 ms.
TURN_DETECTION=manual

# Extra origins allowed to open /ws, comma separated, as scheme://host[:port]. Compared
# as a parsed triple, so case and a default port written either way both match. Loopback
# is always allowed on any port and does not need listing — this is for the day BIND_IP
# opens up and a real page needs in. Without it, /ws answered 101 to any site on the web.
ALLOWED_ORIGINS=

# Which address to listen on. Loopback by default; 0.0.0.0 is the deliberate opt-in for
# when you want a phone on the same wifi to reach it, and it is the setting that makes
# every per-address bound below start meaning something.
BIND_IP=127.0.0.1

# Addresses allowed to rewrite the client address through X-Forwarded-For, comma
# separated. EMPTY BY DEFAULT, and while it is empty the header is ignored entirely.
# Anyone can send an X-Forwarded-For; trusting it without knowing who is in front of you
# hands every caller a supply of invented identities, which is worse than the problem it
# solves. Set this to your reverse proxy's address and nothing else.
#
# You want it set if you ARE behind a proxy: without it every request appears to come
# from one address, which makes MAX_SESSIONS_PER_ADDRESS a cap on the whole deployment.
TRUSTED_PROXIES=

# How many live sessions may exist at once, and how many from one address. Each holds an
# upstream session that is billed while it lives, and eight tabs is eight of them. The
# Origin check says who may ask and the ticket says they asked first; neither says how
# many. Bound to loopback the two numbers coincide.
MAX_SESSIONS=8
MAX_SESSIONS_PER_ADDRESS=4

# How many upgrade tickets one address may hold at once. On loopback that is one person;
# behind a NAT or a reverse proxy it is EVERYONE, and then this — not MAX_SESSIONS — is
# what caps concurrent users.
#
# The GLOBAL bound is derived from this at twice the value and is not configurable, so
# the two cannot be raised out of step. When the table is full the eviction takes the
# oldest ticket from whichever address holds the MOST, so N busy addresses settle at
# 2*MAX_TICKETS_PER_ADDRESS/N each rather than the newest arrival taking everything.
#
# Range 1..2000. Minting is linear in the table size — measured at 73 us at the default
# and 446 us at 2000 — so past a couple of thousand the bound starts being the denial of
# service it exists to prevent.
MAX_TICKETS_PER_ADDRESS=150

# --- session budgets ---------------------------------------------------------
# Bandit's WebSocket timeout is an IDLE timeout and an open microphone is never idle, so
# without these nothing closes a forgotten tab — it holds an upstream session, billed,
# until the laptop sleeps. Both end the session with a message the page renders and a
# button that says "reconectar".

# Wall clock, in seconds. 30..86400.
MAX_SESSION_SECONDS=900

# Microphone budget, in megabytes. 16 kHz s16le is 32 kB/s, so 100 MB is about 52
# minutes of continuous speech — past the clock above, and there to catch a client
# sending faster than real time, which the clock alone would not. 1..10000.
MAX_SESSION_MB=100
